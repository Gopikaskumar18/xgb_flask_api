    "import pickle\n",
    "import xgboost as xgb\n",
    "\n",
    "# Load your original pickled model\n",
    "with open(\"final_xgb_model.pkl\", \"rb\") as f:\n",
    "    model = pickle.load(f)\n",
    "\n",
    "# Save as CPU-friendly model\n",
    "model.get_booster().save_model(\"final_xgb_model_cpu.json\")\n",
    "print(\"CPU-compatible model saved.\")\n"
   ]
